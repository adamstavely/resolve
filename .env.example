# Development only. Never commit real credentials. Copy to .env for local use.
DATABASE_URL=postgres://resolve:resolve@127.0.0.1:55432/resolve

# Public origin of the console + API (Angular dev server proxies /api to the Next.js API).
RESOLVE_ORIGIN=http://127.0.0.1:4200
# Plain-HTTP cookies are allowed only for this local setup; production requires Secure cookies.
RESOLVE_COOKIE_SECURE=false

# OIDC sign-in. Locally this is the mock IdP (npm run dev:idp); production is the organization's
# OIDC/SAML 2.0 IdP over https. The mock reads the same client settings.
OIDC_ISSUER=http://127.0.0.1:3200
OIDC_CLIENT_ID=resolve-dev
OIDC_CLIENT_SECRET=dev-only-mock-client-secret

# IdP group -> Resolve bundles (plan 02). Groups not listed here grant nothing.
RESOLVE_GROUP_BUNDLES={"resolve-admins":["fleet-admin"],"resolve-agents":["fleet-agent"],"resolve-observers":["fleet-observer"],"resolve-announcements":["announcement-author"],"resolve-investigators":["observability-investigator"]}

# Development-only sealing key for tenant secrets and tokens (32 bytes, base64). Replace for any shared environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RESOLVE_ENCRYPTION_KEY=cmVzb2x2ZS1kZXYtb25seS1ub3QtYS1yZWFsLWtleSE=

# Fleet registry projection served by the mock tenants (npm run dev:tenants) and its service token.
REGISTRY_URL=http://127.0.0.1:3300/registry
REGISTRY_TOKEN=dev-only-registry-token-change-me

# Directory API of the (mock) IdP; the directory worker polls it (npm run dev:directory).
DIRECTORY_URL=http://127.0.0.1:3200/directory/users
DIRECTORY_TOKEN=dev-only-directory-token-change-me

# SESSION_ABSOLUTE_MINUTES=720
# SESSION_IDLE_MINUTES=60

# Privileged fleet worker (contract 4). Resolve sends allowlisted commands with this service credential; it never
# holds tenant database credentials. Locally the mock fleet serves it (npm run dev:tenants).
WORKER_URL=http://127.0.0.1:3300/worker
WORKER_TOKEN=dev-only-worker-token-change-me

# Approved support domains: onboarding accepts support hostnames only under these (owner decision 2026-10-12).
SUPPORT_DOMAINS=support.corp.internal,support.test.corp.internal

# Elastic Observability (plan 12, plan 14). Hosts Resolve may connect to; locally the mock Elastic (npm run dev:elastic)
# serves Elasticsearch on 3400 and Kibana on 3401. Its dev-only API keys are in tools/mock-elastic/keys.json.
ELASTIC_ALLOWED_HOSTS=127.0.0.1
