# Development only. Never commit real credentials. Copy to .env for local use.
DATABASE_URL=postgres://resolve:resolve@127.0.0.1:55432/resolve

# Public origin of the console + API (Angular dev server proxies /api to the Next.js API).
RESOLVE_ORIGIN=http://127.0.0.1:4200
# Plain-HTTP cookies are allowed only for this local setup; production requires Secure cookies.
RESOLVE_COOKIE_SECURE=false

# OIDC sign-in. Locally this is the mock IdP (npm run dev:idp); production is the organization's
# OIDC/SAML 2.0 IdP over https. The mock reads the same client settings.
OIDC_ISSUER=http://127.0.0.1:3200
OIDC_CLIENT_ID=resolve-dev
OIDC_CLIENT_SECRET=dev-only-mock-client-secret

# IdP group -> Resolve bundles (plan 02). Groups not listed here grant nothing.
RESOLVE_GROUP_BUNDLES={"resolve-admins":["fleet-admin"],"resolve-agents":["fleet-agent"],"resolve-observers":["fleet-observer"],"resolve-announcements":["announcement-author"]}

# SESSION_ABSOLUTE_MINUTES=720
# SESSION_IDLE_MINUTES=60
