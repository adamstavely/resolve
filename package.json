{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n idp,tenants,elastic,directory,jobs,integrations,api,console \"npm run dev:idp\" \"npm run dev:tenants\" \"npm run dev:elastic\" \"npm run dev:directory\" \"npm run dev:jobs\" \"npm run dev:integrations\" \"npm run dev -w @resolve/api\" \"ng serve console --host 127.0.0.1\"",
    "dev:idp": "node --env-file-if-exists=.env --import tsx tools/mock-idp/server.mts",
    "dev:tenants": "node --env-file-if-exists=.env --import tsx tools/mock-tenant/server.mts",
    "dev:elastic": "node --env-file-if-exists=.env --import tsx tools/mock-elastic/server.mts",
    "dev:directory": "node --env-file-if-exists=.env --import tsx apps/api/scripts/directory-sync.mts",
    "dev:jobs": "node --env-file-if-exists=.env --import tsx apps/api/scripts/fleet-jobs.mts",
    "dev:integrations": "node --env-file-if-exists=.env --import tsx apps/api/scripts/integration-worker.mts",
    "dev:seed": "node --env-file-if-exists=.env --import tsx apps/api/scripts/seed-dev-tenant-clients.mts",
    "build": "ng build console && npm run build -w @resolve/api",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && ng build console --configuration development && npm run typecheck -w @resolve/api",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "db:test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "elastic:fixtures": "node --env-file-if-exists=.env --import tsx tools/mock-elastic/record-fixtures.mts",
    "load:stream": "node --env-file-if-exists=.env --import tsx tools/load/stream-load.mts",
    "load:harness": "node --env-file-if-exists=.env --import tsx tools/load/stream-harness.mts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/elements": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tslib": "2.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
